{
  "name": "verbweaver",
  "version": "0.9.0",
  "description": "A writing and design platform that thinks in relationships (graphs)",
  "private": true,
  "workspaces": [
    "backend",
    "frontend",
    "shared",
    "desktop"
  ],
  "scripts": {
    "dev": "concurrently \"npm run dev:backend\" \"npm run dev:frontend\"",
    "dev:backend": "cd backend && python run_dev.py",
    "dev:frontend": "cd frontend && npm run dev",
    "dev:desktop": "cd desktop && npm run dev",
    "build": "npm run build:shared && npm run build:frontend && npm run build:backend",
    "build:shared": "cd shared && npm run build",
    "build:frontend": "cd frontend && npm run build",
    "build:backend": "cd backend && echo 'Backend is Python, no build needed'",
    "build:desktop": "cd desktop && npm run build",
    "test": "npm run test --workspaces",
    "lint": "npm run lint --workspaces"
  },
  "devDependencies": {
    "@types/path-browserify": "^1.0.3",
    "concurrently": "^7.6.0",
    "electron": "27.1.3"
  },
  "engines": {
    "node": ">=16.0.0",
    "npm": ">=8.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Verbweaver/verbweaver.git"
  },
  "keywords": [
    "writing",
    "graph",
    "markdown",
    "git",
    "project-management"
  ],
  "author": "Your Name",
  "license": "MIT",
  "dependencies": {
    "@types/js-yaml": "^4.0.9",
    "gray-matter": "^4.0.3",
    "js-yaml": "^4.1.0"
  }
}
